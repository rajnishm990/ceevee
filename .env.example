#Storage
# 'local' writes encrypted blobs to the local filesystem. 's3' requires AWS keys.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_vault

#Cache / Rate Limiting 
# Assumes a local Redis container (e.g., docker run -d -p 6379:6379 redis:alpine)
REDIS_URL=redis://localhost:6379/0